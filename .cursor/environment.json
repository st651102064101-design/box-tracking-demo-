{
  "name": "BoxTrace (Next.js + Express + PGlite)",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "npm run dev:backend"
    },
    {
      "name": "frontend",
      "command": "npm run dev:frontend"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 3000 },
    { "name": "backend", "port": 4000 }
  ]
}
