# ── BoxTrace backend configuration ───────────────────────────────
# Copy to .env and adjust for your environment.

# HTTP
PORT=4000
# Comma-separated list of allowed CORS origins (the Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=12h
# Shared secret a fixed Zebra FX9600 RFID reader's IoT Connector HTTP-POST
# profile sends back as the X-Webhook-Secret header on every tag-read
# webhook (see routes/rfid.ts's fx9600Webhook, POST /api/rfid/fx9600/:gate/webhook).
# The reader has no operator logged in to hold a JWT, so this is that
# endpoint's entire auth story — set it here and in the reader's profile.
FX9600_WEBHOOK_SECRET=change-me-in-production-please-use-a-long-random-string
# First-run seed admin (created by `npm run db:seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=ผู้ดูแลระบบ

# Database
# When USE_PGLITE=true an in-process WASM Postgres is used (no server needed) —
# handy for tests / quick local runs. Data is stored under PGLITE_DIR.
# For real deployments set USE_PGLITE=false and point DATABASE_URL at Postgres 16.
USE_PGLITE=false
PGLITE_DIR=./.pglite
DATABASE_URL=postgres://boxtrace:boxtrace@localhost:5432/boxtrace

# Email (PDA forgot-PIN codes go straight to the employee's own inbox — see
# routes/pin.ts). Any standard SMTP account works, e.g. a Gmail address with
# an app password, or a transactional-email provider's SMTP relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if left blank.
SMTP_FROM=
