{
  "name": "smarttrace-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "npm audit --audit-level=low"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "postcss": "8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.7",
    "vite": "7.3.7"
  }
}
