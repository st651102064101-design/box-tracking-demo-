# Secrets for docker-compose.yml. Generate a real file with:  sh scripts/setup-env.sh
# The backend refuses to start in production with empty, short or published values.
#
# Upgrading a database that already exists: Postgres only reads POSTGRES_PASSWORD
# when it creates the data volume. Change the stored password once, before
# starting the backend:
#   docker compose up -d db
#   docker compose exec db psql -U boxtrace -c "ALTER USER boxtrace PASSWORD '<POSTGRES_PASSWORD>'"
POSTGRES_PASSWORD=
# 32 characters or more
JWT_SECRET=
# 16 characters or more; also configured on the FX9600 reader
FX9600_WEBHOOK_SECRET=
# 16 characters or more; also configured on the LPR camera
LPR_WEBHOOK_SECRET=
# 10 characters or more; used only when there is no admin account yet
SEED_ADMIN_PASSWORD=
